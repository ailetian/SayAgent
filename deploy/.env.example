# SayAgent 全栈 docker-compose 环境变量示例
# 用法：cp deploy/.env.example deploy/.env  然后按需修改；deploy/.env 不进 git（已在 .gitignore 约定）
# 说明：所有值均为「本地演示默认值」；生产必须把密码 / JWT 秘钥 / LLM Key 改成强随机值。

# —— 中间件密码（与 M1/T2 本地 compose 约定一致；缺省走弱默认）——
MYSQL_PASSWORD=hify
MYSQL_ROOT_PASSWORD=root
POSTGRES_PASSWORD=hify

# —— 业务秘钥（§7.11：生产务必覆盖）——
# JWT 签名秘钥：至少 32 字节的随机串
SAYAGENT_JWT_SECRET=dev-only-secret-key-please-change-in-prod-32bytes!!
# 管理员初始密码（AdminSeedRunner 播种 admin 用）
SAYAGENT_ADMIN_PASSWORD=admin123

# —— 安全闸门（P3 收口）——
# 设为 true 时，若 JWT 秘钥 / 管理员密码 / 数据库密码仍为弱默认值，启动直接失败（fail-fast），
# 必须改成强随机值才能启动。本地演示保持 false（仅打印告警，不阻断启动）。
# 生成强秘钥示例：openssl rand -base64 48
SAYAGENT_PRODUCTION=false
